{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./.oxlintrc.devkit.jsonc"],
  "rules": {
    "landmines-testing/no-fixed-sleep": [
      "error",
      {
        "allow": {
          "src/test/messages-wait.e2e.test.ts": 1
        }
      }
    ],
    "landmines-testing/no-flake-masking": [
      "error",
      {
        "allow": {
          "src/db/background-migrations.test.ts": 1,
          "src/test/telegram.integration.test.ts": 8
        }
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "src/commands/contacts.test.ts",
        "src/commands/send.test.ts",
        "src/commands/user.test.ts",
        "src/daemon/daemon-accounts.connect.test.ts",
        "src/services/telegram-factory.test.ts",
        "src/test/fake-client-cli.test-utils.ts",
        "src/test/fake-telegram-client.test-utils.ts"
      ],
      "rules": {
        "no-restricted-properties": "off"
      }
    }
  ]
}
