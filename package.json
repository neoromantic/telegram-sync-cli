{
  "name": "@goodit/telegram-sync-cli",
  "version": "0.7.0",
  "description": "Agent-friendly Telegram sync CLI with full API support",
  "type": "module",
  "bin": {
    "tg": "bin/tg.js"
  },
  "files": [
    "bin/tg.js",
    "src/**/*.ts",
    "!src/__tests__/**",
    "!src/__e2e__/**",
    "!src/__integration__/**",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build": "bun build ./src/index.ts --compile --outfile dist/tg",
    "build:minify": "bun build ./src/index.ts --compile --minify --sourcemap --outfile dist/tg",
    "build:all": "bun run scripts/build-all.ts",
    "check": "bun run lint && bun run typecheck",
    "typecheck": "tsc --noEmit",
    "test": "bun test --isolate src/__tests__",
    "test:e2e": "bun test src/__e2e__",
    "test:integration": "bun test src/__integration__",
    "test:all": "bun test --isolate",
    "test:coverage": "bun test --isolate --coverage",
    "test:build": "bun run scripts/test-build.ts",
    "test:install": "bun run scripts/test-install.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "bunx lefthook install"
  },
  "keywords": [
    "telegram",
    "cli",
    "mtproto",
    "telegram-api",
    "agent",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neoromantic/telegram-sync-cli.git"
  },
  "bugs": {
    "url": "https://github.com/neoromantic/telegram-sync-cli/issues"
  },
  "homepage": "https://tg.sergeybaus.com",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "packageManager": "bun@1.4.3",
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.3",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mtcute/bun": "^0.32.6",
    "citty": "^0.2.2",
    "qrcode-terminal": "^0.12.0"
  }
}
